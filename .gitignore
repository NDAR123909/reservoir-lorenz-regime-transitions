__pycache__/
*.pyc

# Regenerable caches. These rebuild deterministically from the logged seeds
# (see the reproducibility statement), so they are kept out of the repo.
# (git has no trailing comments, so each note sits on its own line)
# C2-C4 ground-truth bifurcation + VGTT cache
data/truth_cache.pkl
# C1 ground-truth bifurcation cache
data/ground_truth_*.pkl
# per-config training segments (md5-seeded)
data/segcache/
data/*.log

# Deliberately NOT ignored (shipped so figures reproduce from cache):
#   data/C2_cells/  data/C3_cells/  data/C4_cells/   the 480 sweep cells
#   data/c1v2_preds/                                 the 10 C1 prediction cells
#   data/*.json                                      small gate/diagnostic logs
paper/
figures/*.pdf
